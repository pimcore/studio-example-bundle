{# The small "Talk" link of the portal footer (F157, assets/portal/talk/README.md): an icon from portal_engine's own
   set, named by aria-label and title, linking the portal page "Talk". The URL and the label come from the server
   (Portal\Talk\TalkTwigExtension, TalkPage); outside a portal there is no Talk page and nothing is rendered. Shown
   through the demo's footer snippet (footer-snippet.html.twig), at the end of the portal's footer. #}
{% set talk = studioExampleEnterprise_talk() %}
{% if talk %}
<style>
    .sx-footer-talk { display: inline-flex; align-items: center; justify-content: center; width: 2em; height: 2em; border-radius: var(--p-radius); color: var(--p-text-secondary); }
    .sx-footer-talk:hover, .sx-footer-talk:focus-visible { color: var(--p-primary); background: var(--p-primary-bg); }
    .sx-footer-talk svg { width: 1.25em; height: 1.25em; fill: currentColor; }
</style>
<a class="sx-footer-talk" href="{{ talk.url }}" aria-label="{{ talk.label }}" title="{{ talk.label }}">{{ portalEngine_inline_icon('chalkboard-teacher') }}</a>
{% endif %}
