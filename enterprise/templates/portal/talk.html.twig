{% extends '@PimcorePortalEngine/layout/studio.html.twig' %}

{# The portal page "Talk" (src/Portal/Talk/TalkController.php): the slide viewer full-screen. The portal's own app
   bundle is not loaded: with the chrome gone there is no island for it to mount, and the viewer brings its own code. #}

{% block studioHead %}
    <style>
        {# the frame covers the whole window, above whatever the layout still draws #}
        .pe-talk-frame { position: fixed; inset: 0; width: 100%; height: 100%; border: 0; z-index: 1000; background: #000; }
        {# F106: without the viewer, a short notice in the kit's tokens #}
        .pe-talk-missing { max-width: 40rem; margin: var(--p-space-xxl) auto; padding: var(--p-space-lg); font-family: var(--p-font-family); font-size: var(--p-font-size); color: var(--p-text); }
        .pe-talk-missing h1 { margin: 0 0 var(--p-space-md); font-size: var(--p-font-size-h3); font-weight: var(--p-font-weight-strong); }
        .pe-talk-missing p { margin: 0 0 var(--p-space-md); color: var(--p-text-secondary); }
        .pe-talk-missing a { color: var(--p-primary); }
    </style>
{% endblock %}

{# A talk is shown full-screen: no header, no navigation rail, no footer. #}
{% block shellHeader %}{% endblock %}
{% block shellNav %}{% endblock %}
{% block shellFooter %}{% endblock %}

{% block studioContent %}
    {% if viewerMissing %}
    {# F106: the default viewer file is not installed. Framing its URL would show Portal Engine's error page for the
       404 inside the frame, so the page says what is missing instead (the controller logs a warning too). #}
    <section class="pe-talk-missing">
        <h1>The slide viewer is not installed</h1>
        <p>{{ installStep }}</p>
        <a href="{{ homeUrl ?? portalEngine_portalConfig().portalDocument }}">Back to the portal</a>
    </section>
    {% else %}
    {# allow="fullscreen": the viewer's F key puts the frame itself into full screen #}
    {# F38: the viewer is told it is shown in the portal and takes the portal's brand colour, the colour the layout
       writes into --pe-brand #}
    {% set talkBrand = portalEngine_portalConfig().colorPrimary|default('#2B0080') %}
    {% set viewerUrl = viewerUrl ~ ('?' in viewerUrl ? '&' : '?') ~ 'host=portal&accent=' ~ talkBrand|url_encode %}
    <iframe class="pe-talk-frame" src="{{ viewerUrl }}" title="{{ pageTitleOverride }}" allow="fullscreen" allowfullscreen></iframe>
    {% endif %}
{% endblock %}
