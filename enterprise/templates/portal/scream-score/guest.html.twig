{% extends '@PimcoreStudioExampleEnterprise/portal/scream-score/layout.html.twig' %}

{# The scream score form of one coaster (GuestController::form()). Plain HTML: it works on a phone without JavaScript.
   After a refused send it shows what was typed and one message next to each wrong field; the pass message stands under
   the pass code, for number and code together. It never shows other guests' ratings. #}

{% block title %}Scream score: {{ coasterName }}{% endblock %}

{% block content %}
    <h1>How loud did you scream on {{ coasterName }}?</h1>
    {% if notice %}<p class="ss-notice" role="alert">{{ notice }}</p>{% endif %}
    <form method="post" novalidate>
        <div class="ss-field" role="radiogroup" aria-labelledby="score-label"{% if errors.score is defined %} aria-describedby="score-error"{% endif %}>
            <span class="ss-legend" id="score-label">Your scream score</span>
            <div class="ss-scores">
                {% for score in scores %}
                    <label class="ss-score"><input type="radio" name="score" value="{{ score.value }}"{% if chosenScore == score.value %} checked{% endif %}{% if score.label %} aria-label="{{ score.value }}, {{ score.label }}"{% endif %}><span>{{ score.value }}</span></label>
                {% endfor %}
            </div>
            <p class="ss-hint ss-ends"><span>1 barely a squeak</span><span>10 lost my voice</span></p>
            {% if errors.score is defined %}<p class="ss-error" id="score-error">{{ errors.score }}</p>{% endif %}
        </div>
        <div class="ss-field">
            <label for="comment">Comment (optional)</label>
            <textarea id="comment" name="comment" aria-describedby="comment-count{% if errors.comment is defined %} comment-error{% endif %}">{{ typed.comment }}</textarea>
            <p class="ss-hint" id="comment-count" aria-live="polite">Up to {{ maxComment }} characters.</p>
            {% if errors.comment is defined %}<p class="ss-error" id="comment-error">{{ errors.comment }}</p>{% endif %}
        </div>
        <div class="ss-field">
            <label for="passNumber">Annual-pass number</label>
            <input type="text" id="passNumber" name="passNumber" value="{{ typed.passNumber }}" placeholder="PK-2026-0001" autocomplete="off" autocapitalize="characters">
        </div>
        <div class="ss-field">
            <label for="passCode">Pass code</label>
            <input type="text" id="passCode" name="passCode" value="{{ typed.passCode }}" autocomplete="off" autocapitalize="none" spellcheck="false"{% if errors.pass is defined %} aria-describedby="pass-error"{% endif %}>
            <p class="ss-hint">Number and code are on the back of your pass.</p>
            {% if errors.pass is defined %}<p class="ss-error" id="pass-error">{{ errors.pass }}</p>{% endif %}
        </div>
        <input type="hidden" name="_token" value="{{ token }}">
        <button type="submit" class="p-login-cta">Send my scream score</button>
    </form>
    {# Only a counter: without it the hint above says the limit, and the server checks it either way. #}
    <script>
        (function () {
            var field = document.getElementById('comment');
            var count = document.getElementById('comment-count');
            var update = function () { count.textContent = field.value.length + ' of {{ maxComment }} characters'; };
            field.addEventListener('input', update);
            if (field.value !== '') { update(); }
        })();
    </script>
{% endblock %}
