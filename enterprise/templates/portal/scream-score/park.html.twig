{% extends '@PimcoreStudioExampleEnterprise/portal/scream-score/layout.html.twig' %}

{# The park's overview of the scream scores (ParkController, staff only): one row per coaster with its average, the
   number of ratings and the guest link to copy. With `refused` set, only that message (403, 404 or 400). No pass
   numbers, no comments here. #}

{% block title %}{{ refused ?: 'Scream scores' }}{% endblock %}

{% block styles %}
        .ss-list { margin: 0; padding: 0; list-style: none; }
        .ss-row { padding: var(--p-space-sm, 12px) 0; border-top: 1px solid var(--p-border-secondary, #f0f0f0); }
        .ss-row:first-child { border-top: 0; }
        .ss-row h2 { margin: 0; font-size: var(--p-font-size-lg, 16px); font-weight: var(--p-font-weight-strong, 600); }
        .ss-facts { display: flex; flex-wrap: wrap; gap: var(--p-space-xs, 8px) var(--p-space-md, 16px); margin: var(--p-space-xxs, 4px) 0; }
        .ss-average { font-size: var(--p-font-size-h4, 20px); font-weight: var(--p-font-weight-strong, 600); }
        .ss-row input[type=text] { font-size: var(--p-font-size, 14px); }
{% endblock %}

{% block content %}
    {% if refused %}
        <h1>{{ refused }}</h1>
    {% else %}
        <h1>Scream scores</h1>
        <ul class="ss-list">
            {% for coaster in coasters %}
                <li class="ss-row">
                    <h2><a class="ss-link" href="{{ coaster.page }}">{{ coaster.name }}</a></h2>
                    <p class="ss-facts">
                        {% if coaster.count == 0 %}
                            <span class="ss-hint">No ratings yet</span>
                        {% else %}
                            <span class="ss-average">{{ coaster.average }} / 10</span>
                            <span class="ss-hint">{{ coaster.count }} {{ coaster.count == 1 ? 'rating' : 'ratings' }}</span>
                        {% endif %}
                    </p>
                    <label class="ss-hint" for="link-{{ coaster.key }}">Guest link</label>
                    <input type="text" id="link-{{ coaster.key }}" value="{{ coaster.link }}" readonly>
                </li>
            {% else %}
                <li class="ss-row ss-hint">No coasters yet. Run coaster-demo:setup.</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
